# Copy to .env.local for local work. Never commit real values.
# Production/preview values live in Vercel project settings (docs/11-delivery-workflow.md §3).

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # prod: https://jelarshad.shojashapta.com (preview falls back to the branch URL)
NEXT_PUBLIC_LAUNCHED=false                  # false = "শিগগিরই আসছে" page + noindex
PREVIEW_ACCESS_SECRET=                      # /?preview=<secret> lets founding contributors in before launch
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# Provider selection (swap vendors here). Defaults are mock so the app runs with no accounts.
AUTH_PROVIDER=mock                          # supabase | mock
DB_PROVIDER=mock                            # supabase | mock
NEXT_PUBLIC_STORAGE_PROVIDER=mock           # cloudinary | imagekit | supabase | mock
ANALYTICS_PROVIDER=noop                     # noop | vercel

# Supabase (required when AUTH_PROVIDER or DB_PROVIDER is supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                  # server only, never exposed

# Cloudinary (required when NEXT_PUBLIC_STORAGE_PROVIDER is cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Shown on the privacy page for data-removal requests (optional)
NEXT_PUBLIC_CONTACT_EMAIL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=                      # server only
CLOUDINARY_UPLOAD_FOLDER=shojashapta

# Admin bootstrap (comma-separated)
ADMIN_EMAILS=
