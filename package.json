{
  "name": "jelarshad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:themes": "vitest run scripts/check-themes.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local > src/infrastructure/supabase/database.types.ts",
    "db:seed": "tsx scripts/seed/generate.ts",
    "analyze": "ANALYZE=true next build --webpack",
    "prepare": "husky"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.106.1",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.11.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "harfbuzzjs": "1.6.4",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/bundle-analyzer": "16.4.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.18.0",
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
